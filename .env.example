# Local development template. Replace placeholder secrets before starting Compose.
# Never commit a populated .env file.

# Node
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# App
APP_NAME=Arena Eleggante
LOG_LEVEL=info
APP_KEY=replace-with-generated-app-key
APP_URL=http://localhost:3333

# Session
SESSION_DRIVER=database

DB_HOST=database
DB_PORT=5432
DB_USER=arena
DB_PASSWORD=replace-with-local-db-password
DB_DATABASE=arena_dev
QUEUE_DRIVER=database

# Operational email; Mailpit is the local transport.
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=acesso@arena.example

# Set both only when the SMTP provider requires authentication.
# SMTP_USERNAME=
# SMTP_PASSWORD=
